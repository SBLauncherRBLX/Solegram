// Solegram: Telegram's liquid glass shader with two extra controls.
// dispersion - splits colours along the refracted edge (0 = off)
// rim        - light on the glass's edge, from the top left (0 = off)
uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;
uniform float dispersion;
uniform float rim;
// the iOS-like shape (SolegramSquircle): half the base's size and how much its sides are puffed out (beta: top and
// bottom, gamma: left and right); x = 0 for a plain rounded rect
uniform float4 squircle;
// the corners: their radii along x and y, and their superellipse exponent (2: an ellipse's quarter)
uniform float3 squircle_r;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

float sdfShape(float2 p, half4 r) {
  if (squircle.x <= 0.0) {
    return sdfRect(half2(p), r);
  }
  // back from the puffed-out shape to the base (the stretch is small: a few steps are exact enough)
  float2 a = abs(p);
  float2 b = a;
  for (int i = 0; i < 3; i++) {
    float ty = min(b.y / squircle.y, 1.0);
    b.x = a.x / (1.0 + squircle.w * (1.0 - ty * ty));
    float tx = min(b.x / squircle.x, 1.0);
    b.y = a.y / (1.0 + squircle.z * (1.0 - tx * tx));
  }
  float2 rad = squircle_r.xy;
  float n = squircle_r.z;
  // from the corner's centre; the straight sides are where one of q is not past it
  float2 q = b - (squircle.xy - rad);
  float straight = max(q.x - rad.x, q.y - rad.y);
  float2 u = max(q, float2(0.0)) / rad;
  float m = max(u.x, u.y);
  if (m <= 0.0) {
    return straight;
  }
  // the corner: the superellipse's level, over its gradient for a distance in pixels
  float2 v = max(u / m, float2(0.0001));
  bool isRound = n <= 2.001;
  float2 vn = isRound ? v * v : pow(v, float2(n));
  float s = vn.x + vn.y;
  float level = m * (isRound ? sqrt(s) : pow(s, 1.0 / n));
  float2 g = (isRound ? v : pow(v, float2(n - 1.0))) / (isRound ? sqrt(s) : pow(s, (n - 1.0) / n)) / rad;
  float corner = (level - 1.0) / max(length(g), 0.00001);
  return max(corner, straight);
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  float2 pf = fragCoord - center;
  half2 p = pf;
  half sdRaw = sdfShape(pf, radius);
  // past the edge the lens goes on as at the edge: the outline clips it, but a downsampled glass is upscaled over it
  half sd = min(sdRaw, 0.0);
  float2 uv = fragCoord;
  float2 offset = float2(0.0);
  half edge = 0.0;
  half sdX = 0.0;
  half sdY = 0.0;
  {
    sdX = sdfShape(pf + float2(1.0, 0.0), radius);
    sdY = sdfShape(pf + float2(0.0, 1.0), radius);

    half n_cos = max(thickness + sd, 0.0) / thickness;
    half n_cos2 = n_cos * n_cos;
    half n_sin = sqrt(1.0 - n_cos2);
    half3 normal = normalize(half3((sdX - sdRaw) * n_cos, (sdY - sdRaw) * n_cos, n_sin));

    half3 refract_vec = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / refract_index);
    half h = sd < -thickness ? thickness : sqrt(sd * (-2.0 * thickness - sd));
    half refract_length = (h + 8.0 * thickness) / -refract_vec.z;

    offset = refract_vec.xy * refract_length * refract_intensity;
    uv += offset;
    edge = n_cos;
  }
  // on a small shape the edge samples past the far side: stay within the shape, whatever the grid of a downsampled node
  uv = clamp(uv, center - size + 0.5, center + size - 0.5);

  half4 color = img.eval(uv);
  if (dispersion > 0.0 && sdRaw < 0.0) {
    // five taps across the spectrum instead of three hard copies: soft rainbow fringes along the bevel
    half4 c0 = img.eval(clamp(uv + offset * dispersion, center - size + 0.5, center + size - 0.5));
    half4 c1 = img.eval(clamp(uv + offset * dispersion * 0.5, center - size + 0.5, center + size - 0.5));
    half4 c3 = img.eval(clamp(uv - offset * dispersion * 0.5, center - size + 0.5, center + size - 0.5));
    half4 c4 = img.eval(clamp(uv - offset * dispersion, center - size + 0.5, center + size - 0.5));
    color = half4(c0.r * 0.45 + c1.r * 0.35 + color.r * 0.2,
                  c1.g * 0.2 + color.g * 0.55 + c3.g * 0.25,
                  color.b * 0.1 + c3.b * 0.4 + c4.b * 0.5,
                  c0.a * 0.15 + c1.a * 0.2 + color.a * 0.3 + c3.a * 0.2 + c4.a * 0.15);
    color.rgb = min(color.rgb, half3(color.a));
  }
  if (rim > 0.0 && sdRaw < 0.0) {
    // light from the top left, as on real glass: the edges facing it and the opposite ones shine, the flanks
    // much less; a crisp line right on the outline gives the glass its edge, a soft glow across the bevel its
    // thickness, and a faint shade along the far inner edge its depth (it used to be one even glow all round)
    half2 n2 = half2(sdX - sd, sdY - sd);
    half nl = length(n2);
    n2 = nl > 0.0001 ? n2 / nl : half2(0.0, -1.0);
    half facing = dot(n2, half2(-0.7071, -0.7071));
    half lit = 0.3 + 0.7 * facing * facing;
    half near = facing > 0.0 ? 1.0 : 0.7;
    half strength = rim / 0.35;                                  // the setting, 0..1
    half lineK = 0.2 + 0.55 * strength;
    half glowK = 0.05 + 0.25 * strength;
    half outline = 1.0 - smoothstep(0.8, 2.8, -sd);
    half e = edge * edge;
    half spec = clamp((lineK * outline + glowK * e * e) * lit * near, 0.0, 1.0);
    // screen blend, premultiplied: bright on dark glass, gentle on light
    color.rgb = color.rgb + half3(spec) * (half3(color.a) - color.rgb);
    half far = facing < 0.0 ? -facing : 0.0;
    color.rgb *= 1.0 - 0.07 * strength * far * e;
  }

  return srcOver(half4(foreground_color_premultiplied), color);
}
