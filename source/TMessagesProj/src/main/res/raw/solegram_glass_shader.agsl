// Solegram: Telegram's liquid glass shader with two extra controls.
// dispersion - splits colours along the refracted edge (0 = off)
// rim        - light on the glass's edge, from the top left (0 = off)
uniform shader img;

uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;
uniform float dispersion;
uniform float rim;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  half2 p = fragCoord - center;
  half sd = sdfRect(p, radius);
  float2 uv = fragCoord;
  float2 offset = float2(0.0);
  half edge = 0.0;
  if (sd < 0.0) {
    half sdX = sdfRect(p + half2(1.0, 0.0), radius);
    half sdY = sdfRect(p + half2(0.0, 1.0), radius);

    half n_cos = max(thickness + sd, 0.0) / thickness;
    half n_cos2 = n_cos * n_cos;
    half n_sin = sqrt(1.0 - n_cos2);
    half3 normal = normalize(half3((sdX - sd) * n_cos, (sdY - sd) * n_cos, n_sin));

    half3 refract_vec = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / refract_index);
    half h = sd < -thickness ? thickness : sqrt(sd * (-2.0 * thickness - sd));
    half refract_length = (h + 8.0 * thickness) / -refract_vec.z;

    offset = refract_vec.xy * refract_length * refract_intensity;
    uv += offset;
    edge = n_cos;
  }

  half4 color = img.eval(uv);
  if (dispersion > 0.0 && sd < 0.0) {
    // five taps across the spectrum instead of three hard copies: soft rainbow fringes along the bevel
    half4 c0 = img.eval(uv + offset * dispersion);
    half4 c1 = img.eval(uv + offset * dispersion * 0.5);
    half4 c3 = img.eval(uv - offset * dispersion * 0.5);
    half4 c4 = img.eval(uv - offset * dispersion);
    color = half4(c0.r * 0.45 + c1.r * 0.35 + color.r * 0.2,
                  c1.g * 0.2 + color.g * 0.55 + c3.g * 0.25,
                  color.b * 0.1 + c3.b * 0.4 + c4.b * 0.5,
                  c0.a * 0.15 + c1.a * 0.2 + color.a * 0.3 + c3.a * 0.2 + c4.a * 0.15);
    color.rgb = min(color.rgb, half3(color.a));
  }
  if (rim > 0.0 && sd < 0.0) {
    // light from the top left, as on real glass: the edges facing it and the opposite ones shine, the flanks
    // much less; a crisp line right on the outline gives the glass its edge, a soft glow across the bevel its
    // thickness, and a faint shade along the far inner edge its depth (it used to be one even glow all round)
    half2 n2 = half2(sdfRect(p + half2(1.0, 0.0), radius) - sd, sdfRect(p + half2(0.0, 1.0), radius) - sd);
    half nl = length(n2);
    n2 = nl > 0.0001 ? n2 / nl : half2(0.0, -1.0);
    half facing = dot(n2, half2(-0.7071, -0.7071));
    half lit = 0.3 + 0.7 * facing * facing;
    half near = facing > 0.0 ? 1.0 : 0.7;
    half strength = rim / 0.35;                                  // the setting, 0..1
    half lineK = 0.2 + 0.55 * strength;
    half glowK = 0.05 + 0.25 * strength;
    half outline = 1.0 - smoothstep(0.8, 2.8, -sd);
    half e = edge * edge;
    half spec = clamp((lineK * outline + glowK * e * e) * lit * near, 0.0, 1.0);
    // screen blend, premultiplied: bright on dark glass, gentle on light
    color.rgb = color.rgb + half3(spec) * (half3(color.a) - color.rgb);
    half far = facing < 0.0 ? -facing : 0.0;
    color.rgb *= 1.0 - 0.07 * strength * far * e;
  }

  return srcOver(half4(foreground_color_premultiplied), color);
}
