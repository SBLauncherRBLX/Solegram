// Solegram: the glass lens of the tab bar's selection while it is pressed or dragged (iOS 26 style).
// Clear glass over the tabs (img). The surface is a capsule with a rounded (quarter-circle) bevel along its
// rim: flat in the middle, steeper and steeper towards the outline. The middle magnifies a little and stays
// sharp; across the bevel the glass bends the picture more and more, so what lies near the rim is pulled out
// towards it and stretched along the curved edge (on the round ends the arc spreads it sideways too), and the
// colours split there like in a prism: blue and violet bent the most, red and orange the least. The rim is lit
// with the colours around it (what lies just outside the outline and what the glass shows just inside),
// brightened: a crisp line on the outline and a softer glow across the bevel give the glass its thickness;
// a very soft shade lies just inside it. Almost no body colour, so the bar shows through.
uniform shader img;

uniform float2 center;    // px
uniform float2 halfSize;  // px, half width / half height of the capsule
uniform float magnify;    // centre magnification, 1 = none
uniform float band;       // px, width of the curved rim band (the bevel)
uniform float bend;       // px, how far the bevel moves the picture at the outline
uniform float dispersion; // 0..1, colour split in the rim band
uniform float light;      // 0..1, rim line strength
uniform float shade;      // 0..1, soft dark inner edge
uniform float4 tint;      // premultiplied glass body colour (very faint)
uniform float dp;         // px per dp
uniform float2 barCenter; // px, the bar's glass capsule (the picture is empty outside it)
uniform float2 barHalf;   // px
uniform float dark;       // 1 in a dark theme: the rim is made to look as it does in the light one

// a point moved into the bar's glass (a little in from its outline): the lens is taller than the bar, and
// outside the bar the picture is empty, which split the colours there into a red line
float2 inBar(float2 q) {
  float r0 = min(barHalf.x, barHalf.y);
  float r = max(1.0, r0 - 2.5 * dp);
  float ext = max(barHalf.x, barHalf.y) - r0;
  float2 v = q - barCenter;
  float2 a = barHalf.x >= barHalf.y ? float2(clamp(v.x, -ext, ext), 0.0) : float2(0.0, clamp(v.y, -ext, ext));
  float2 w = v - a;
  float l = length(w);
  if (l > r) {
    w *= r / l;
  }
  return barCenter + a + w;
}

half4 S(float2 q) {
  return img.eval(inBar(q));
}

half4 main(float2 fragCoord) {
  float2 p = fragCoord - center;

  // the capsule as a segment with a radius: distance and outward normal in one go (exact, no extra taps)
  float r = min(halfSize.x, halfSize.y);
  float ext = max(halfSize.x, halfSize.y) - r;
  float2 axis = halfSize.x >= halfSize.y ? float2(clamp(p.x, -ext, ext), 0.0) : float2(0.0, clamp(p.y, -ext, ext));
  float2 v = p - axis;
  float vl = length(v);
  float sd = vl - r;
  float coverage = clamp(0.5 - sd, 0.0, 1.0);
  if (coverage <= 0.0) {
    return half4(0.0);
  }
  float2 n = vl > 0.0001 ? v / vl : float2(0.0, -1.0);

  // the bevel: a quarter circle across the band, h = sqrt(1 - (1 - depth / band)^2); flat glass inside it
  float depth = -sd;                                          // px inside the outline
  float t = clamp(depth / max(band, 1.0), 0.0, 1.0);          // 0 on the rim, 1 at the band's inner edge
  float x = 1.0 - t;
  float h = sqrt(max(0.0, 1.0 - x * x));

  // where the bevel takes the picture from, in band widths from the outline: s0 right on the rim, t again where
  // the flat glass starts. It eases in with the slope of the bevel and flattens out at the rim, so what lies
  // near the rim is drawn out to it and smeared there instead of folding over into a mirrored copy
  float s0 = clamp(bend / max(band, 1.0), 0.3333, 0.6667);
  float g = s0 + (2.0 - 3.0 * s0) * t * t + (2.0 * s0 - 1.0) * t * t * t;
  float shift = band * (g - t) * min(1.0, bend / max(band * s0, 0.001));
  // and right at the outline the steep circle turns it a little over the edge: the picture bends round it
  shift += 0.04 * bend * (1.0 - h);

  // the middle magnifies; the bevel bends the picture on top of that. The sample is taken further in, along
  // the normal: what lies near the rim is stretched across the bevel, and on the round ends it comes from a
  // smaller arc, so it spreads along the edge as well. A slight pull towards the centre on top of it bends
  // straight lines near the rim along the curve, as a thick lens does (more of it closed the icons into rings).
  float2 mid = p / magnify;
  float2 pull = n * shift + mid * (0.08 * shift / max(r, 1.0));
  float2 base = center + mid;

  // colour split: a share of the bend, so the fringes are widest at the rim and fade out with the bend inside
  float k = 0.2 * dispersion;
  half4 c = S(base - pull);
  if (k > 0.004 && shift > 0.25) {
    // five taps across the spectrum, each bent a little more than the last (red least, violet most), blended
    // back into RGB: smooth rainbow fringes instead of three hard copies
    half4 t0 = S(base - pull * (1.0 - k));
    half4 t1 = S(base - pull * (1.0 - 0.5 * k));
    half4 t3 = S(base - pull * (1.0 + 0.5 * k));
    half4 t4 = S(base - pull * (1.0 + k));
    half3 rgb = half3(t0.r * 0.45 + t1.r * 0.35 + c.r * 0.2,
                      t1.g * 0.2 + c.g * 0.55 + t3.g * 0.25,
                      c.b * 0.1 + t3.b * 0.4 + t4.b * 0.5);
    half al = t0.a * 0.15 + t1.a * 0.2 + c.a * 0.3 + t3.a * 0.2 + t4.a * 0.15;
    // premultiplied: keep the colour no brighter than its coverage
    c = half4(min(rgb, half3(al)), al);
  }

  // almost clear body under the picture
  half4 col = c + half4(tint) * (1.0 - c.a);

  // soft dark inner edge, fading in over the band
  float inner = shade * x * x;
  col = half4(col.rgb * (1.0 - inner), col.a + inner * (1.0 - col.a));

  // the rim's light takes the colours next to it: just outside the outline and just inside the glass
  half4 outA = S(fragCoord + n * (3.0 * dp));
  half4 outB = S(fragCoord + n * (7.0 * dp) + float2(-n.y, n.x) * (4.0 * dp));
  half4 inA = S(base - n * (2.0 * dp));
  half4 env = outA * 0.4 + outB * 0.25 + inA * 0.35;
  half3 e = env.a > 0.01 ? env.rgb / env.a : half3(1.0);
  e = mix(half3(1.0), e, half(clamp(env.a, 0.0, 1.0)));      // nothing there: plain white light
  // only the hue of what is near counts, not how dark it is: the rim is as bright in a dark theme as in
  // the light one (a dark bar would otherwise make it a dull grey)
  half mx = max(max(e.r, e.g), e.b);
  e = e / max(mx, 0.12);
  e = mix(half3(1.0), e, half(0.85));                         // the hue a touch softer: light, not paint
  half lum = dot(e, half3(0.299, 0.587, 0.114));
  e = clamp(mix(half3(lum), e, 1.6), 0.0, 1.0);              // a little richer, as light through coloured glass
  half3 rimCol = clamp(0.38 + 0.8 * e, 0.0, 1.0);           // brightened, keeps its hue
  rimCol *= half(mix(1.0, 0.78, dark));                       // a light line on a dark bar stands out far more

  // lit from the top-left: that side and the opposite one shine, the flanks less
  float2 L = normalize(float2(-0.7, -0.7));
  float d = dot(n, L);
  float facing = abs(d);
  float lit = 0.3 + 0.7 * facing * facing;
  float near = d > 0.0 ? 1.0 : 0.7;                           // the far side a touch dimmer
  // crisp line on the outline (about 1.5dp)
  float edgeLine = light * mix(1.0, 0.42, dark) * (1.0 - smoothstep(0.7 * dp, 1.8 * dp, depth)) * lit * near;
  // the bevel's glow (about 5dp): the thickness of the glass
  float bevel = 1.0 - smoothstep(0.0, 5.0 * dp, depth);
  // light over a dark picture shows much more than over a white one: less of it in a dark theme, so the
  // rim reads the same in both
  float glow = light * mix(0.42, 0.08, dark) * bevel * bevel * lit * near;
  // a small bright glint where the light hits straight
  float glint = light * mix(0.3, 0.14, dark) * (1.0 - smoothstep(1.0 * dp, 3.0 * dp, depth)) * facing * facing * facing * facing;
  float hl = clamp(edgeLine + glint, 0.0, 1.0);
  float gl = clamp(glow, 0.0, 1.0);
  // glow: the rim colour laid over like light (screen), then the crisp line on top
  half3 lightCol = rimCol * half(gl);
  col = half4(col.rgb + lightCol * (1.0 - col.rgb), col.a + half(gl) * (1.0 - col.a));
  col = half4(col.rgb * (1.0 - half(hl)) + rimCol * half(hl), col.a + half(hl) * (1.0 - col.a));

  return col * coverage;
}
