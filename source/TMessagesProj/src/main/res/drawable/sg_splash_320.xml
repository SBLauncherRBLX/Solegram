<?xml version="1.0" encoding="utf-8"?>
<!--
    Solegram launch animation (Android 12+ splash screen): the Solegram mark on the window's own background, as
    Telegram shows its logo - the sun rises from behind its horizon, the two message lines open out from the middle
    one after the other, and the whole mark settles with a soft scale. The mark is the launcher icon's
    (sg_icon_fg_mono geometry, 108 units) scaled into the 320-unit splash canvas: the visible circle is r=100.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="splash"
            android:width="320dp"
            android:height="320dp"
            android:viewportWidth="320"
            android:viewportHeight="320">
            <group
                android:name="pop"
                android:pivotX="160"
                android:pivotY="160"
                android:scaleX="0.82"
                android:scaleY="0.82">
                <group
                    android:name="mark"
                    android:translateX="-23.6"
                    android:translateY="-23.6"
                    android:scaleX="3.4"
                    android:scaleY="3.4">
                    <group android:name="horizon">
                        <clip-path
                            android:name="sky"
                            android:pathData="M0,0 L108,0 L108,56.7 L0,56.7 Z"/>
                        <group
                            android:name="sun_rise"
                            android:translateY="21">
                            <path
                                android:name="sun"
                                android:pathData="M35.4,55.395 A18.6,18.6 0 0 1 72.6,55.395 A1.24,1.24 0 0 1 71.36,56.635 L36.64,56.635 A1.24,1.24 0 0 1 35.4,55.395 Z"
                                android:fillColor="#FF5B3A"
                                android:fillAlpha="0"/>
                        </group>
                    </group>
                    <group
                        android:name="line_top"
                        android:pivotX="54"
                        android:pivotY="61.44"
                        android:scaleX="0">
                        <path
                            android:name="line_top_path"
                            android:pathData="M38.345,59.115 L69.655,59.115 A2.325,2.325 0 0 1 69.655,63.765 L38.345,63.765 A2.325,2.325 0 0 1 38.345,59.115 Z"
                            android:fillColor="#FF8C73"/>
                    </group>
                    <group
                        android:name="line_bottom"
                        android:pivotX="54"
                        android:pivotY="68.88"
                        android:scaleX="0">
                        <path
                            android:name="line_bottom_path"
                            android:pathData="M45.165,66.555 L62.835,66.555 A2.325,2.325 0 0 1 62.835,71.205 L45.165,71.205 A2.325,2.325 0 0 1 45.165,66.555 Z"
                            android:fillColor="#FF8C73"/>
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="pop">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:startOffset="40"
                    android:duration="560"
                    android:valueFrom="0.82"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:startOffset="40"
                    android:duration="560"
                    android:valueFrom="0.82"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="sun_rise">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:startOffset="60"
                android:duration="520"
                android:valueFrom="21"
                android:valueTo="0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:startOffset="60"
                android:duration="160"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/linear"/>
        </aapt:attr>
    </target>
    <target android:name="line_top">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleX"
                android:startOffset="240"
                android:duration="380"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="line_bottom">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleX"
                android:startOffset="330"
                android:duration="370"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>
